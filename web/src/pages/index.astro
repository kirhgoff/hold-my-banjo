---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>hold-my-banjo</title>
  </head>
  <body>
    <h1>hold-my-banjo</h1>
    <p>
      A live, in-browser chorus of eastern banjo frogs (pobblebonk, <em>Limnodynastes dumerilii</em>). Each frog calls
      on its own jittered rhythm; the coupled modes below make frogs react to calls from their neighbours and are
      <strong>hypothetical</strong>, borrowed from Japanese tree frog models rather than measured banjo frog behaviour.
    </p>

    <form id="controls">
      <label>
        Frogs
        <input type="range" id="frogs" min="1" max="100" step="1" value="8" />
        <output id="frogs-out">8</output>
      </label>
      <label>
        Seed
        <input type="number" id="seed" value="42017" />
      </label>
      <label>
        Mode
        <select id="mode">
          <option value="0">independent</option>
          <option value="1">event_delay</option>
          <option value="2">event_advance</option>
          <option value="3">phase_coupled</option>
        </select>
      </label>
      <label>
        Coupling strength
        <input type="range" id="strength" min="0" max="1" step="0.01" value="0" />
        <output id="strength-out">0</output>
      </label>
      <label>
        Mean interval (s)
        <input type="range" id="interval" min="0.8" max="8" step="0.1" value="3" />
        <output id="interval-out">3</output>
      </label>
      <label>
        Hearing radius (m)
        <input type="range" id="radius" min="1" max="40" step="1" value="15" />
        <output id="radius-out">15</output>
      </label>
      <fieldset id="bonk">
        <legend>Bonk</legend>
        <label>
          Pitch (Hz)
          <input type="range" id="bonk-pitch" min="100" max="1500" step="1" value="440" />
          <output id="bonk-pitch-out">440</output>
        </label>
        <label>
          Spread (Hz)
          <input type="range" id="bonk-spread" min="0" max="200" step="1" value="40" />
          <output id="bonk-spread-out">40</output>
        </label>
        <label>
          Duration (s)
          <input type="range" id="bonk-duration" min="0.05" max="1" step="0.01" value="0.25" />
          <output id="bonk-duration-out">0.25</output>
        </label>
        <label>
          Attack (s)
          <input type="range" id="bonk-attack" min="0.0005" max="0.1" step="0.0005" value="0.002" />
          <output id="bonk-attack-out">0.002</output>
        </label>
        <label>
          Decay (s)
          <input type="range" id="bonk-decay" min="0.005" max="1" step="0.005" value="0.06" />
          <output id="bonk-decay-out">0.06</output>
        </label>
        <label>
          Sweep depth
          <input type="range" id="bonk-sweep" min="-0.5" max="1" step="0.01" value="0.15" />
          <output id="bonk-sweep-out">0.15</output>
        </label>
        <label>
          Sweep time (s)
          <input type="range" id="bonk-sweep-s" min="0.001" max="0.2" step="0.001" value="0.02" />
          <output id="bonk-sweep-s-out">0.02</output>
        </label>
        <label>
          2nd harmonic
          <input type="range" id="bonk-h2" min="0" max="1" step="0.01" value="0.35" />
          <output id="bonk-h2-out">0.35</output>
        </label>
        <label>
          3rd harmonic
          <input type="range" id="bonk-h3" min="0" max="1" step="0.01" value="0.1" />
          <output id="bonk-h3-out">0.1</output>
        </label>
        <canvas id="bonk-wave" width="900" height="120"></canvas>
        <div>
          <button id="audition" type="button">Audition</button>
          <button id="bonk-reset" type="button">Reset bonk</button>
        </div>
      </fieldset>
      <button id="play" type="button">Play</button>
    </form>

    <canvas id="scene" width="900" height="600"></canvas>
    <canvas id="wave" width="900" height="120"></canvas>

    <section>
      <h2>Real chorus for comparison</h2>
      <audio controls preload="none" src="/banjo-frogs-long.m4a"></audio>
    </section>

    <script>
      import { init } from '../chorus';
      init();
    </script>

    <style>
      #controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 0.75rem 1.5rem;
        align-items: center;
        margin: 1.5rem 0;
      }

      #controls label {
        justify-content: space-between;
      }

      #controls input[type='range'] {
        flex: 1;
      }

      #play {
        grid-column: 1 / -1;
        justify-self: start;
      }

      #bonk {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 0.75rem 1.5rem;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        margin: 0;
      }

      #bonk canvas {
        grid-column: 1 / -1;
      }

      canvas + canvas {
        margin-top: 1rem;
      }

      section {
        margin-top: 1.5rem;
      }
    </style>
  </body>
</html>
